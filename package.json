{
  "name": "options-decision-lab",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-pages-dotfiles.mjs",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "smoke:production": "node scripts/smoke-production.mjs",
    "perf:bundle": "node scripts/check-bundle-budget.mjs",
    "perf:lighthouse": "lhci autorun",
    "perf:lighthouse:production": "lhci autorun --config=lighthouserc.production.json",
    "preview": "vite preview --host 0.0.0.0",
    "build:pages": "tsc -b && vite build --mode pages && node scripts/copy-pages-dotfiles.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-check": "^4.11.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5"
  }
}
