{
  "ci": {
    "collect": {
      "url": "https://raawaa93.github.io/Sol/",
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-production"
    }
  }
}
